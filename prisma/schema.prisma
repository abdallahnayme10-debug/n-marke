// N-marke — Schéma de base de données (Prisma)
// Développement : SQLite. Production : basculer DATABASE_URL vers PostgreSQL.
// NB : SQLite ne supporte pas les enums => on utilise des String avec valeurs contrôlées.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Utilisateur (acheteur + vendeur + livreur : un seul profil) ─────────
model User {
  id            String   @id @default(cuid())
  name          String
  phone         String?  @unique
  email         String?  @unique
  passwordHash  String
  isVerified    Boolean  @default(false) // confirmé par email
  island        String? // "grande-comore" | "anjouan" | "moheli"
  region        String?
  profilePhoto  String?
  bio           String?

  // Statut / profil
  role          String   @default("user") // "user" | "courier" | "admin"
  sellerTier    String   @default("occasionnel") // "occasionnel" | "regulier" | "premium"
  premiumUntil  DateTime?
  isCourier     Boolean  @default(false)

  // Parrainage
  referralCode  String   @unique
  referredById  String?
  referredBy    User?    @relation("Referrals", fields: [referredById], references: [id])
  referredUsers User[]   @relation("Referrals")

  // Préférences
  theme         String   @default("auto") // "light" | "dark" | "auto"
  dataSaver     Boolean  @default(false)
  smsEnabled    Boolean  @default(true)

  // Sécurité connexion
  loginAttempts Int      @default(0)
  lockedUntil   DateTime?

  createdAt     DateTime @default(now())
  lastLoginAt   DateTime?

  listings      Listing[]
  favorites     Favorite[]
  stockAlerts   StockAlert[]
  ordersBuyer   Order[]    @relation("OrderBuyer")
  ordersSeller  Order[]    @relation("OrderSeller")
  deliveries    Delivery[]
  sentMessages  Message[]  @relation("SentMessages")
  recvMessages  Message[]  @relation("ReceivedMessages")
  reviews       Review[]   @relation("ReviewsWritten")
  reviewsOn     Review[]   @relation("ReviewsReceived")
  comments      Comment[]
  reportsMade   Report[]   @relation("ReportsMade")
  reportsOn     Report[]   @relation("ReportsAgainst")
  payments      Payment[]
  ads           Ad[]
  referralsMade Referral[] @relation("ReferralsMade")
  notifications Notification[]
  searchLogs    SearchLog[]

  @@index([phone])
}

// ── Code de vérification (envoyé par email) ────────────────────────────
model VerificationCode {
  id        String   @id @default(cuid())
  phone     String?
  email     String?
  code      String
  type      String // "register" | "reset" | "change-number"
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, type])
  @@index([phone, type])
}

// ── Catégories et sous-catégories ──────────────────────────────────────
model Category {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  icon         String
  sort         Int           @default(0)
  listings     Listing[]
  subcategories Subcategory[]
}

model Subcategory {
  id         String   @id @default(cuid())
  name       String
  slug       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  listings   Listing[]

  @@unique([categoryId, slug])
}

// ── Annonce ────────────────────────────────────────────────────────────
model Listing {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String
  price          Int? // en KMF ; null si "prix à débattre"
  negotiable     Boolean  @default(false)

  type           String   @default("disponible") // "disponible" | "commande" | "occasion" | "particulier"
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  subcategoryId  String?
  subcategory    Subcategory? @relation(fields: [subcategoryId], references: [id])
  brand          String?
  model          String?
  articleNumber  String   @unique // NMK-XXXXX
  quantity       Int      @default(1)
  size           String?
  color          String?
  condition      String? // "neuf" | "comme-neuf" | "bon-etat" | "etat-correct" | "pieces"

  island         String
  region         String
  neighborhood   String?

  // Livraison moto
  deliveryAvailable Boolean @default(false)
  deliveryZones     String?
  deliveryFeePaidBy String? // "seller" | "buyer" | "free"
  deliveryTime      String?

  // Commande (vente sur commande)
  orderLeadTime     String?
  orderDeposit      Boolean @default(false)
  orderDepositPct   Int?
  orderDeadline     DateTime?
  orderMinQty       Int?

  photos       String // JSON array d'URLs
  videoUrl     String?
  tags         String // JSON array
  views        Int      @default(0)
  status       String   @default("active") // "active" | "disabled" | "sold" | "expired"

  isFeatured    Boolean   @default(false)
  featuredUntil DateTime?

  expiresAt    DateTime?
  sellerId     String
  seller       User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  favorites     Favorite[]
  stockAlerts   StockAlert[]
  orders        Order[]
  reviews       Review[]
  comments      Comment[]
  reports       Report[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([status])
  @@index([island, region])
}

// ── Favoris / liste de souhaits ────────────────────────────────────────
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

// ── Alerte de disponibilité ────────────────────────────────────────────
model StockAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

// ── Commande ───────────────────────────────────────────────────────────
model Order {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id])
  buyerId     String
  buyer       User     @relation("OrderBuyer", fields: [buyerId], references: [id])
  sellerId    String
  seller      User     @relation("OrderSeller", fields: [sellerId], references: [id])
  quantity    Int      @default(1)
  total       Int?
  status      String   @default("recue") // "recue" | "confirmee" | "preparation" | "livraison" | "livree" | "annulee"
  note        String?

  // Livraison demandée par l'acheteur
  deliveryRequested Boolean  @default(false)
  deliveryAddress   String?
  deliveryPhone     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  Delivery[]
}

// ── Livraison par moto ─────────────────────────────────────────────────
model Delivery {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierId  String
  courier    User     @relation(fields: [courierId], references: [id])
  sellerId   String
  buyerId    String
  status     String   @default("en_attente") // "en_attente" | "en_route_vendeur" | "recupere" | "en_cours" | "livre" | "annulee"
  price      Int?
  pickupAddress  String?
  dropoffAddress String?
  zone       String?
  acceptedAt DateTime?
  deliveredAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Message privé ──────────────────────────────────────────────────────
model Message {
  id        String   @id @default(cuid())
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver  User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  listingId String?
  body      String?
  image     String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId])
}

// ── Avis (note en étoiles, réservé aux acheteurs) ──────────────────────
model Review {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewsWritten", fields: [authorId], references: [id])
  sellerId  String
  seller    User     @relation("ReviewsReceived", fields: [sellerId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([sellerId])
}

// ── Commentaire public ─────────────────────────────────────────────────
model Comment {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// ── Litige / réclamation ───────────────────────────────────────────────
model Report {
  id          String   @id @default(cuid())
  type        String // "non_recu" | "different" | "endommage" | "vendeur_muet" | "livreur" | "autre"
  description String
  photos      String? // JSON array
  status      String   @default("ouvert") // "ouvert" | "examine" | "resolu"
  resolution  String?
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id])
  orderId     String?
  reporterId  String
  reporter    User     @relation("ReportsMade", fields: [reporterId], references: [id])
  againstId   String
  against     User     @relation("ReportsAgainst", fields: [againstId], references: [id])
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}

// ── Paiement (validation manuelle phase 1) ─────────────────────────────
model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  service     String // "feature" | "premium" | "ad"
  description String
  amount      Int
  method      String // "mvola" | "pokera" | "kartapay"
  reference   String? // référence de transaction saisie par l'utilisateur
  status      String    @default("en_attente") // "en_attente" | "valide" | "rejete"
  adId        String?
  ad          Ad?       @relation(fields: [adId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  validatedAt DateTime?
}

// ── Publicité (campagne sponsorisée payante) ───────────────────────────
model Ad {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  image     String?
  link      String // URL cible (annonce N-marke ou site externe)
  days      Int
  amount    Int
  status    String    @default("en_attente") // "en_attente" | "active" | "expiree" | "rejetee"
  startsAt  DateTime?
  endsAt    DateTime?
  payments  Payment[]
  createdAt DateTime  @default(now())
}

// ── Parrainage ─────────────────────────────────────────────────────────
model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referrer   User     @relation("ReferralsMade", fields: [referrerId], references: [id])
  refereeId  String
  reward     String? // "feature-7j" | "premium-7j" | "feature-3j"
  createdAt  DateTime @default(now())
}

// ── Notification (in-app) ──────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ── Bannière promotionnelle ────────────────────────────────────────────
model Banner {
  id         String    @id @default(cuid())
  title      String
  message    String
  categoryId String?
  color      String    @default("#C8963E")
  emoji      String?
  active     Boolean   @default(true)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
}

// ── Journal de recherche (statistiques) ────────────────────────────────
model SearchLog {
  id        String   @id @default(cuid())
  query     String
  type      String   @default("text") // "text" | "vision"
  island    String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// ── Vue d'annonce (statistiques jour par jour) ─────────────────────────
model ViewLog {
  id        String   @id @default(cuid())
  listingId String
  date      String // YYYY-MM-DD
  count     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([listingId, date])
}

// ── Réglages clé/valeur (période gratuite, etc.) ───────────────────────
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
