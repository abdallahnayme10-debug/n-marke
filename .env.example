# ── N-marke — Variables d'environnement ─────────────────────────────
# Copie ce fichier en `.env` et remplis les valeurs. Ne mets JAMAIS `.env` sur GitHub.

# Base de données
# Local (développement) : SQLite. Pour la production, remplace par une URL PostgreSQL.
DATABASE_URL="file:./dev.db"

# Sécurité / sessions JWT
JWT_SECRET="change-moi-par-une-longue-chaine-aleatoire-et-secrete"

# URL publique de la plateforme
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Accès propriétaire (mot de passe secret de l'espace de gestion)
OWNER_PASSWORD="change-moi"

# Connexion Google (OAuth) — obtenir sur https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email (confirmation de compte, réinitialisation mot de passe) ─────
# Vide = mode "email simulé" (le code s'affiche dans les logs serveur).
# Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=toi@gmail.com, SMTP_PASS=mot de passe d'application.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="N-marke <no-reply@nmarke.com>"

# ── SMS (notifications, en option) ────────────────────────────────────
SMS_PROVIDER=""
SMS_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""

# ── Paiement M-Vola / Pokéra ──────────────────────────────────────────
# Numéro marchand (affiché pour le transfert manuel)
MVOLA_MERCHANT_NUMBER="+2694909765"
POKERA_NUMBER=""

# Paiement EN LIGNE M-Vola (à obtenir auprès de Comores Telecom / du fournisseur).
# Dès que MVOLA_CONSUMER_KEY + SECRET sont remplis, le paiement en ligne s'active.
MVOLA_CONSUMER_KEY=""
MVOLA_CONSUMER_SECRET=""
MVOLA_PASSKEY=""
MVOLA_API_BASE="https://api.mvola.km"

# ── Phase 2 (autres passerelles) ──────────────────────────────────────
KARTAPAY_API_KEY=""
KARTAPAY_SECRET_KEY=""

# ── Recherche par image (Google Vision / Clarifai) — vide = "simulation"
GOOGLE_VISION_API_KEY=""
CLARIFAI_API_KEY=""

# ── Cloudinary (stockage images / vidéos)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
